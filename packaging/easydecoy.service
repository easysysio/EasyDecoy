# systemd service unit for EasyDecoy (installed by the deb/rpm packages).
# Enable + start with:  sudo systemctl enable --now easydecoy
[Unit]
Description=EasyDecoy decoy network services
Documentation=https://github.com/easysysio/EasyDecoy
# After the host's own sshd (ssh.service on Debian and Ubuntu, sshd.service
# elsewhere), so at boot sshd always gets port 22 first: an SSH decoy left on
# port 22 shows "Not running" rather than lock you out.
After=network-online.target ssh.service sshd.service
Wants=network-online.target

[Service]
Type=simple
Environment=EASYDECOY_CONFIG=/etc/easydecoy/easydecoy.toml
ExecStart=/usr/bin/easydecoy
Restart=on-failure
RestartSec=2

# An account of its own, never root. A decoy is the one service built to be
# found by an intruder, and all it needs beyond an ordinary user is to bind the
# real ports (23, 80, 21, 22). The management GUI listens on 127.0.0.1:9443 by
# default. The package creates the account (packaging/post-install.sh, run
# after every install and upgrade).
User=easydecoy
Group=easydecoy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Creates /var/lib/easydecoy, where the database is kept (settings, events,
# GUI accounts), and /var/log/easydecoy, for an events file set in the GUI.
# Both belong to the account above; systemd makes them before the service
# starts, and tells EasyDecoy the first through STATE_DIRECTORY.
StateDirectory=easydecoy
StateDirectoryMode=0750
LogsDirectory=easydecoy
UMask=0027

# What it has no business touching. The whole filesystem is read-only to it
# except those two directories; it gets no devices, no home directories, a /tmp of
# its own, and only the system calls an ordinary network service makes.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
